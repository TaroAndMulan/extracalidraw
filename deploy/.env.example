# Copy to deploy/.env and edit.

# Your domain (DNS must point to this VM), or the VM's IP address
DOMAIN=board.example.com

# Name shown on the login page and in the browser tab
APP_NAME=Extracalidraw

# First admin account, created on the first start.
# If ADMIN_PASSWORD is empty, a random one is printed in the logs:
#   docker compose logs whiteboard
# Special characters ($ ! @ # spaces)? Use single quotes, read as they are:
#   ADMIN_PASSWORD='p@ss$word!'
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-please

# Forgot the admin password? Set a new ADMIN_PASSWORD, set this to true,
# run `docker compose up -d`, sign in, then set it back to empty.
RESET_ADMIN_PASSWORD=

# Websites allowed to embed papers in an <iframe>:
#   *                       any website (default)
#   https://mysite.com      only your site (space separated list)
#   none                    disable embedding
EMBED_ALLOWED_ORIGINS=*
