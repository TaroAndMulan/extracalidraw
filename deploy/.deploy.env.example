# Settings for deploy/deploy.sh, on your computer (not on the server).
# Copy to deploy/.deploy.env (git-ignored) and edit. Environment variables
# with the same names win over this file.

# ssh target: a Host from ~/.ssh/config (key login, no password prompt), or
# user@host
DEPLOY_HOST=my-server

# the checkout on the server, relative to the ssh user's home directory
DEPLOY_DIR=extracalidraw

# public address, for the checks from your computer (empty: skip them)
DEPLOY_URL=https://board.example.com

# the app's port on the server: the left number of "127.0.0.1:3002:3002" in
# docker-compose.override.yml (with Caddy, publish it the same way)
DEPLOY_PORT=3002
