# nginx site for the whiteboard, when nginx already serves 80/443 on the
# server (WHITEBOARD.md → "Already running nginx"). Replace board.example.com
# with your domain, then:
#
#   sudo cp nginx.conf.example /etc/nginx/sites-available/whiteboard
#   sudo ln -s /etc/nginx/sites-available/whiteboard /etc/nginx/sites-enabled/
#   sudo nginx -t && sudo systemctl reload nginx
#   sudo certbot --nginx -d board.example.com --redirect
#
# (no sites-available? use /etc/nginx/conf.d/whiteboard.conf instead)
# certbot adds the HTTPS (443) part, the redirect from http, and renews the
# certificate by itself.

server {
    listen 80;
    server_name board.example.com;

    location / {
        # the port in docker-compose.override.yml (left side)
        proxy_pass http://127.0.0.1:3002;
        # live collaboration runs over WebSockets
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        # the app checks the Host header (same-site requests, cookies)
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # a lesson keeps its connection open
        proxy_read_timeout 1h;
        # images and PDFs
        client_max_body_size 25m;
    }
}
